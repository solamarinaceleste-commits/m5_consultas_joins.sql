-- CONSULTAS DE VALIDACIÓN

SELECT * FROM Categorías;
SELECT * FROM clientes;
SELECT * FROM productos;
SELECT * FROM ventas;

--- Consulta 1 — Vista base del proyecto (INNER JOIN)

SELECT 
    v.fecha_venta,
    c.id_cliente,
    c.nombre AS nombre_cliente,
    c.ciudad,
    p.producto_id,
    p.nombre AS nombre_producto,
    cat.nombre_categoria AS categoria,
    cat.descripcion AS descripcion_categoria,
    v.cantidad,
    p.precio AS precio_unitario,
    (v.cantidad * p.precio) AS total_venta
FROM ventas v
INNER JOIN clientes c 
    ON v.cliente_id = c.id_cliente
INNER JOIN productos p 
    ON v.producto_id = p.producto_id
INNER JOIN Categorías cat 
    ON p.categoria = cat.nombre_categoria;

--- Consulta 2 — Clientes sin ventas (LEFT JOIN)
-- Identificá clientes registrados que aún no han realizado ninguna compra. Mostrá su nombre, email y fecha de registro. Usá WHERE ... IS NULL para aislar los casos.

SELECT 
c.id_cliente, c.nombre AS nombre_cliente, c.email, c.fecha_registro
FROM clientes c
LEFT JOIN ventas v
ON v.cliente_id = c.id_cliente
WHERE v.venta_id IS NULL, 

-- Consulta 3 — Productos sin ventas
--- Productos sin ventas (LEFT JOIN) Identificá productos del catálogo que no tienen ninguna venta registrada. Mostrá nombre del producto, categoría y precio. Usá WHERE ... IS NULL.

SELECT p.producto_id, p.nombre, p.categoria, p.precio
FROM productos p
LEFT JOIN ventas v
ON p.producto_id = v.producto_id 
WHERE v.venta_id IS NULL,

-- ────────────────────────────────────────────────────────────────────
-- Consulta 4: Consolidado por canal / origen (UNION ALL)
-- ────────────────────────────────────────────────────────────────────

SELECT 
    canal,
    COUNT(*) AS total_transacciones,
    SUM(total_venta) AS monto_total
FROM (
    -- Subconsulta A: Ventas anteriores a febrero clasificadas como 'Online'
    SELECT 
        v.venta_id,
        v.fecha_venta,
        (v.cantidad * p.precio) AS total_venta,
        'Online' AS canal
    FROM ventas v
    INNER JOIN productos p 
        ON v.producto_id = p.producto_id
    WHERE v.fecha_venta < '2024-02-01'
    
    UNION ALL
    
    -- Subconsulta B: Ventas desde febrero en adelante clasificadas como 'Presencial'
    SELECT 
        v.venta_id,
        v.fecha_venta,
        (v.cantidad * p.precio) AS total_venta,
        'Presencial' AS canal
    FROM ventas v
    INNER JOIN productos p 
        ON v.producto_id = p.producto_id
    WHERE v.fecha_venta >= '2024-02-01'
) AS ventas_consolidadas
GROUP BY canal;
